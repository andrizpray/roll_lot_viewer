APP_NAME="Roll Lot Viewer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# API key for protecting API endpoints (required in production)
API_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Laravel sekarang pakai PostgreSQL (sama dengan Python worker).
# Pastikan database sudah dibuat dan user sudah diberi akses sebelum migrate.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=roll_lot_viewer
DB_USERNAME=roll_lot_user
DB_PASSWORD=
# DB_DATABASE=database/database.sqlite  <-- SQLite lama, tidak dipakai lagi

QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
